// Journaux d'exploitation : notifications envoyées, actions sensibles.

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

/// Journal des envois.
///
/// `idempotencyKey` est la garantie qu'un client ne reçoit jamais deux fois le
/// même rappel : le job de rappel peut être rejoué sans risque, ce qui est
/// indispensable puisqu'un SMS envoyé ne se rattrape pas.
model NotificationLog {
  id            String  @id @default(cuid())
  salonId       String
  appointmentId String?

  channel  NotificationChannel
  /// Identifiant du gabarit : `booking_confirmed`, `reminder_j1`, ...
  template String

  /// Empreinte du destinataire, jamais l'adresse ni le numéro en clair : le
  /// CLAUDE.md interdit toute donnée personnelle dans les journaux.
  recipientHash String

  status NotificationStatus @default(QUEUED)

  /// Identifiant renvoyé par Resend ou Twilio, pour rapprochement en cas de
  /// litige sur un envoi.
  providerId String?
  error      String?

  attempts Int       @default(0)
  sentAt   DateTime? @db.Timestamptz(3)

  idempotencyKey String @unique

  salon       Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([salonId, status])
  @@index([appointmentId])
}

/// Journal d'audit des actions sensibles : annulation d'un rendez-vous,
/// invitation ou révocation d'un membre, modification d'un tarif.
///
/// `actorId` est en `SetNull` et les métadonnées ne doivent contenir aucune
/// donnée personnelle : la trace doit survivre à l'anonymisation d'un compte
/// sans la contredire.
model AuditLog {
  id      String  @id @default(cuid())
  salonId String?
  actorId String?

  /// Verbe canonique : `appointment.cancelled`, `member.invited`, ...
  action     String
  targetType String
  targetId   String

  metadata Json @default("{}")

  salon Salon? @relation(fields: [salonId], references: [id], onDelete: Cascade)
  actor User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([salonId, createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}
