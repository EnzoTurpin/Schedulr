// Comptes, sessions et consentements.
//
// Les modèles User, Account, Session et VerificationToken suivent le contrat
// attendu par l'adaptateur Prisma d'Auth.js : leurs noms de champs ne peuvent
// pas être francisés ni renommés sans casser l'adaptateur.

enum UserRole {
  CLIENT
  PLATFORM_ADMIN
}

model User {
  id String @id @default(cuid())

  email         String    @unique
  emailVerified DateTime? @db.Timestamptz(3)

  /// Empreinte Argon2id. Nul pour un compte créé par lien magique, qui n'a
  /// jamais défini de mot de passe.
  passwordHash String?

  firstName String?
  lastName  String?
  phone     String?

  /// Champs attendus par l'adaptateur Auth.js lors d'une connexion OAuth.
  /// Non utilisés en V1 (aucun fournisseur OAuth), conservés pour ne pas
  /// avoir à migrer le jour où l'un est ajouté.
  name  String?
  image String?

  role UserRole @default(CLIENT)

  /// Anonymisation RGPD : les données personnelles sont écrasées et cette date
  /// est posée. Jamais de suppression physique — les rendez-vous passés doivent
  /// rester exploitables par le salon pour sa comptabilité.
  deletedAt DateTime? @db.Timestamptz(3)

  accounts     Account[]
  sessions     Session[]
  memberships  SalonMember[]
  appointments Appointment[] @relation("clientAppointments")
  consents     ConsentRecord[]
  auditLogs    AuditLog[]
  sentInvitations SalonInvitation[] @relation("sentInvitations")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([deletedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Sessions persistées en base plutôt qu'en JWT : révoquer l'accès d'un
/// employé qui quitte le salon doit prendre effet immédiatement (ADR-0001).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * Jetons à usage unique des liens de connexion.
 *
 * `identifier` porte l'adresse visée, `token` une empreinte SHA-256 : une
 * lecture de la table ne permet pas de forger un lien valide, comme pour les
 * sessions.
 */
/// Usage d'un jeton à usage unique.
///
/// Sans cette distinction, un jeton de vérification d'adresse ouvrirait une
/// session — les deux vivent dans la même table — et demander un lien de
/// connexion effacerait la vérification en cours.
enum TokenPurpose {
  LOGIN
  EMAIL_VERIFICATION
}

model VerificationToken {
  identifier String
  token      String       @unique
  purpose    TokenPurpose @default(LOGIN)
  expires    DateTime     @db.Timestamptz(3)

  @@unique([identifier, token])
  @@index([identifier, purpose])
}

enum ConsentType {
  TRANSACTIONAL_SMS
  MARKETING_EMAIL
  MARKETING_SMS
}

/// Registre des consentements. Historisé plutôt que booléen sur `User` : le
/// RGPD demande de pouvoir prouver *quand* et *comment* un consentement a été
/// donné, et un simple champ écrasé perd cette preuve.
model ConsentRecord {
  id     String      @id @default(cuid())
  userId String
  type   ConsentType

  granted Boolean

  /// Origine de la décision : « inscription », « espace client », etc.
  source String

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

/**
 * Invitation d'une personne à rejoindre l'équipe d'un salon.
 *
 * Distincte de `VerificationToken` : elle porte le membre visé, un statut et
 * son auteur, et sa durée de vie se compte en jours plutôt qu'en minutes.
 *
 * Le membre existe déjà — le salon a créé sa fiche et son agenda ; l'invitation
 * ne fait que rattacher un compte à cette fiche.
 */
model SalonInvitation {
  id      String @id @default(cuid())
  salonId String

  /// Fiche de membre à rattacher au compte qui acceptera.
  memberId String @unique

  /// Adresse invitée, en minuscules. L'acceptation vérifie qu'elle correspond.
  email String

  /// Empreinte du jeton, jamais le jeton lui-même.
  tokenHash String @unique

  status    InvitationStatus @default(PENDING)
  expiresAt DateTime         @db.Timestamptz(3)

  /// Auteur de l'invitation. `SetNull` : la trace survit à l'anonymisation.
  invitedById String?

  acceptedAt DateTime? @db.Timestamptz(3)

  salon     Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  member    SalonMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  invitedBy User?        @relation("sentInvitations", fields: [invitedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([salonId, status])
  @@index([email])
}
